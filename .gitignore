# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Widget Preview related
.widget_preview/
rust/target/

# FVM (Flutter Version Management) — flutter_sdk 是机器专属软链
.fvm/

# VS Code — 本地 SDK 配置不共享，调试配置保留
.vscode/*
!.vscode/launch.json

# Android 构建产物
android/build/

# R2 分发本地私密配置（API Token 等，不入库）
tool/r2.env
tool/sentry.env

# Android 签名物（keystore 私钥 + 密码，绝不入库——丢了老用户就升不了级）
android/key.properties
android/app/*.jks
android/app/*.keystore

# spike 的 Rust 构建产物（可再生，不入库）
spikes/**/target/

# vendor 副本的构建缓存（可再生）
packages/**/.gradle/
packages/**/.dart_tool/
packages/**/build/

# DSHA 烘制产物（254MB 大件可由 packages/dsha_core/tools 确定性重烘，不入库；
# 小件 inputs/layout/manifest/license 作为契约指纹随仓）
/assets/dsha/*.bin
/assets/dsha/*.tar.gz
/assets/dsha/*.crt

# DSHA 烘制工作树（npm 树/下载缓存，可再生）
/app/

# Sentry 原生构建缓存
.sentry-native/
